# Copy this file to .env.local and adjust values as needed
# .env.local is gitignored and won't be committed

# API URL for development (uses Vite proxy)
# In development: /api/stock -> proxied to https://api-rubber-hono.onrender.com/stock
VITE_API_URL=/api/stock

# For testing with a local backend:
# VITE_API_URL=http://localhost:3000/stock
